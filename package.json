{
  "name": "abg-vibes-poc",
  "version": "1.0.0",
  "scripts": {
    "dev:server": "uvicorn backend.server.main:app --reload --port 3001",
    "dev:client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix frontend",
    "start": "uvicorn backend.server.main:app --port 3001"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  }
}
